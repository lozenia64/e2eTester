# Optional AI failure analysis settings
# Copy this file to .env and replace the placeholder values.

E2E_FAILURE_ANALYZER_ENABLED=true
GEMINI_API_KEY=your_actual_api_key
# 1순위|2순위|3순위|4순위 fallback 모델 체인 (동일 API 키). 미설정 시 기본 4모델 체인 사용.
GEMINI_MODELS=gemini-3.1-flash-lite|gemini-2.5-flash|gemini-2.0-flash|gemini-flash-latest
E2E_GEMINI_SSL_VERIFY=true

# Optional end-of-run email notification settings
E2E_EMAIL_ENABLED=true
E2E_EMAIL_GMAIL_ACCOUNT=sender@gmail.com
E2E_EMAIL_GMAIL_APP_PASSWORD=your_actual_app_password
E2E_EMAIL_RECIPIENTS_HOM=user1@company.com|user2@company.com
E2E_EMAIL_RECIPIENTS_MHM=user1@company.com|user2@company.com
E2E_EMAIL_RECIPIENTS_FP=user1@company.com|user2@company.com
E2E_EMAIL_RECIPIENTS_HRP=user1@company.com|user2@company.com
E2E_EMAIL_RECIPIENTS_HWTC=user1@company.com|user2@company.com
E2E_EMAIL_RECIPIENTS_CHBOT=user1@company.com|user2@company.com

# Optional scheduled-run settings
# cron 예약의 기준 타임존. 미설정 시 Asia/Seoul. (예: UTC, Asia/Seoul)
E2E_SCHEDULE_TZ=Asia/Seoul

# Optional persistent state store
# Run/Suite/예약 이력을 저장하는 SQLite 파일 경로. 미설정 시 data/e2etester.db.
E2E_DB_PATH=data/e2etester.db

# Playwright MCP 와 동일 Chrome 프로필 (MHM·HWTC·CHBOT 등, 선택)
# HOM·FP·HRP 는 설치형 보안프로그램 호환을 위해 ~/.e2etester/*-chrome-profile 을 씁니다.
# 미설정 시 %LOCALAPPDATA%/ms-playwright-mcp/mcp-chrome-{workspace_hash} 를 자동 사용.
# E2E_PLAYWRIGHT_MCP_PROFILE_DIR=C:\Users\you\AppData\Local\ms-playwright-mcp\mcp-chrome-34d9f53
# workspace 해시 기준 경로. MCP 브라우저와 동시에 열면 프로필 잠금 오류가 납니다.
# E2E_WORKSPACE_DIR=C:\Users\you\Desktop\e2eTester

# 인증 설정
E2E_JWT_SECRET=change-me-in-production
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=admin1234
