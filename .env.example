# e2eTester 환경변수 예시
#
# 이 도구는 Windows PC 에서 로컬로만 실행한다(서버 배포 없음).
# `cp .env.example .env` 하면 그대로 동작한다. 비밀값과 외부로 열리는
# 기능은 기본 off 이므로, 켤 항목만 골라 채운다.
#   - 값이 들어있는 항목 = 코드 기본값과 동일한 안전한 로컬 개발값
#   - 주석 처리된 항목    = 미설정 시 코드가 알아서 정하거나 기능이 꺼지는 항목
# 우선순위: 터미널 환경변수 > .env > 코드 기본값.
# 각 변수의 의미·상세는 docs/INSTALL.md, 설정 SSOT 는 app/core/settings.py.

# --- 인증 ---
# 서버에 배포하지 않아도 아래 세 값은 교체한다. scripts/run_local.py 가 API 를
# 0.0.0.0:2222 로 바인드하므로(SMS OTP 중계기가 폰에서 접속해야 해서 필요하다),
# 같은 네트워크의 다른 PC 도 관리 화면에 닿는다. 폰 중계를 쓰지 않는다면
# `--api-host 127.0.0.1` 로 띄우는 편이 안전하다.
# 랜덤 값 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
E2E_JWT_SECRET=change-me-to-a-random-value
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=admin1234

# --- 영속 저장소 ---
E2E_DB_PATH=data/e2etester.db
# SQLite 락 대기(ms). 여러 커넥션이 한 파일에 쓰므로 Windows 에서
# "database is locked" 가 보이면 올린다.
E2E_SQLITE_BUSY_TIMEOUT_MS=5000

# --- 실행 동시성 ---
# 헤디드 브라우저 자원을 고려해 보수적으로 둔다(1 이면 한 번에 한 Run 만 실행).
E2E_RUN_CONCURRENCY=4
# 매니페스트 execution_profile 별 동시 실행 상한(ProfilePartitionedRunQueue).
E2E_RUN_CONCURRENCY_HEAVY=2
E2E_RUN_CONCURRENCY_LIGHT=4
E2E_RUN_CONCURRENCY_INTERACTIVE=2

# --- 실행 평면 ---
# local: API 프로세스에서 Playwright in-process 실행(기본·로컬 개발).
# remote: Redis 작업 큐 + 별도 worker 프로세스가 브라우저 실행(scripts/run_local.py).
E2E_EXECUTION_MODE=local
E2E_REDIS_URL=redis://127.0.0.1:6379/0
E2E_WORKER_BASE_URL=http://127.0.0.1:8100
E2E_WORKER_CONCURRENCY=2
# OTP 교차 재기동용 세션 리스 TTL(초). 워커 하트비트가 이 간격으로 갱신한다.
E2E_SESSION_LEASE_TTL=60
# worker.main 프로세스의 바인드 주소. 미설정 시 127.0.0.1:8100 — API·워커가 한 PC 안에서
# 통신하므로 그대로 둔다. 워커를 다른 PC 에 두는 구성에서만 0.0.0.0 으로 바꾼다.
# 포트는 scripts/run_local.py 가 --worker-port 로 자동 주입한다.
# E2E_WORKER_HTTP_HOST=127.0.0.1
# E2E_WORKER_HTTP_PORT=8100
# 다중 API 인스턴스 WS fan-out. 단일 PC 로컬 실행에서는 필요 없다
# (remote 모드에서는 자동 on, local 에서는 명시 opt-in).
# E2E_REALTIME_FANOUT=1

# --- 자동 복구 루프 (docs/specs/run/06-self-recovery-loop.md) ---
# 예약 Run 이 도구 오류(ERROR)로 끝났을 때 실패 모듈부터 1회 자동 재실행.
# tier 2 현행 한계 및 운영 활성화 전 필수 수동 검증 게이트는 SPEC-RUN-006 (FR-004) 참고.
E2E_AUTO_RERUN_ENABLED=false
# Run 당 세션 재개설(tier 2) 허용 횟수. 초과하면 한 단계 낮은 등급으로 재시도.
E2E_RECOVERY_TIER2_BUDGET=2
# Run 총 실행 시간 상한(초). 미설정 시 무제한.
# E2E_RUN_MAX_DURATION_S=3600

# --- 예약·보존 ---
# 예약과 보존 삭제는 API 프로세스 안의 틱 루프가 처리한다 — 해당 시각에 PC 가 켜져
# 있고 프로세스가 떠 있어야 실행되며, 놓친 시각은 따라잡지 않는다. 절전으로 들어가는
# PC 라면 예약 시각을 근무 시간대로 두거나 절전을 끈다.
# cron 예약과 일간 현황의 기준 타임존 (예: UTC, Asia/Seoul).
E2E_SCHEDULE_TZ=Asia/Seoul
# true 이면 매일 아래 cron 시각에 점검실패(ERROR)·취소(CANCELLED) Run 을 삭제한다.
# 정상(PASSED)·이상징후(ANOMALY) 는 유지되고, 당일 00:00 이후 Run 은 다음 날까지 보존.
E2E_RUN_RETENTION_ENABLED=true
# 상황판(/wall) 공개 여부. 로그인 없이 열리는 읽기 전용 화면이다 —
# 사무실 상시 디스플레이가 7일 JWT 만료로 로그인 폼을 띄우는 것을 피하기 위해
# 비인증으로 둔다. 앱이 사내망 밖에서 접근 가능한 배포에서는 false 로 끈다.
E2E_WALL_ENABLED=true
# 메일에 넣을 공개 주소(예: https://e2e.example.com). 비우면 일간 리포트에
# 상황판 링크를 넣지 않는다. E2E_WALL_ENABLED=false 면 설정해도 링크가 안 나간다.
E2E_PUBLIC_BASE_URL=
E2E_RUN_RETENTION_CRON=0 3 * * *

# --- 구조적 로깅 (structlog) ---
# console: 사람이 읽는 컬러 콘솔(로컬 실행 기본)
# json: 한 줄 JSON — 콘솔 출력을 파일로 넘겨 나중에 파싱·집계할 때만 쓴다.
E2E_LOG_LEVEL=INFO
E2E_LOG_FORMAT=console

# --- AI 실패 분석 (Gemini, 선택) ---
# GEMINI_API_KEY 에 실제 키를 넣은 뒤 true 로 바꾼다(placeholder 로는 분석이 실패한다).
E2E_FAILURE_ANALYZER_ENABLED=false
GEMINI_API_KEY=your_actual_api_key
# 1순위|2순위|3순위|4순위 fallback 모델 체인(동일 API 키).
# 미설정 시 아래와 동일한 기본 체인(app/ai/gemini_models.py)을 사용한다.
GEMINI_MODELS=gemini-3.5-flash|gemini-3.1-flash-lite|gemini-3-flash-preview|gemini-3.1-pro-preview
E2E_GEMINI_SSL_VERIFY=true

# --- 종료 메일 (선택) ---
# false 이면 종료 메일을 보내지 않는다.
E2E_EMAIL_ENABLED=false
E2E_EMAIL_GMAIL_ACCOUNT=sender@gmail.com
E2E_EMAIL_GMAIL_APP_PASSWORD=your_actual_app_password
# 시스템별 수신자(| 구분). 키 접미사는 app/systems/*/manifest.yaml 의 시스템 코드다.
E2E_EMAIL_RECIPIENTS_HOM=user1@company.com|user2@company.com
E2E_EMAIL_RECIPIENTS_MHM=user1@company.com|user2@company.com
E2E_EMAIL_RECIPIENTS_FP=user1@company.com|user2@company.com
E2E_EMAIL_RECIPIENTS_HRP=user1@company.com|user2@company.com
E2E_EMAIL_RECIPIENTS_HWTC=user1@company.com|user2@company.com
E2E_EMAIL_RECIPIENTS_CHBOT=user1@company.com|user2@company.com
# 점검 도구 오류(ERROR) 종료 시 알림을 받을 운영자 메일(| 구분).
# 미설정 시 ERROR 메일은 생략된다.
E2E_EMAIL_OPERATOR_RECIPIENTS=operator1@company.com|operator2@company.com
# 일간 리포트 메일 — 어제 점검 결과를 전사 수신자에게 하루 한 통 보낸다.
# 메일은 되돌릴 수 없으므로 기본은 꺼져 있다. 운영 투입 전에는 RECIPIENTS 를
# 본인 주소로만 두고 하루 관찰할 것.
E2E_EMAIL_DAILY_REPORT_ENABLED=false
# 발송 시각(스케줄 타임존 기준 5필드 cron). 비우면 08:00.
E2E_EMAIL_DAILY_REPORT_CRON=0 8 * * *
# 파이프(|) 구분. 비어 있으면 발송하지 않는다.
E2E_EMAIL_DAILY_REPORT_RECIPIENTS=exec1@company.com|exec2@company.com

# --- 수신 OTP 중계 (SMS 자동입력 / 무인 OTP, 선택) ---
# 안드로이드 SMS 중계기가 수신 SMS 의 OTP 를 POST /api/otp/inbound 로 보내
# WAITING_INPUT 으로 멈춘 Run 을 자동 재개한다. 중계기는 X-OTP-Relay-Token 헤더로
# 이 토큰을 보낸다. 미설정 시 엔드포인트가 503 으로 비활성.
# 켤 때는 길고 랜덤한 값을 직접 생성해 넣는다 — 예시값을 그대로 쓰면 누구나 OTP 를
# 주입할 수 있다(placeholder 검증이 없다).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# E2E_OTP_RELAY_TOKEN=
# SMS 원문(text)에서 OTP 를 추출할 정규식. 첫 캡처 그룹을 사용하며 미설정 시 (\d{4,8}).
# 중계기가 code 만 보내면 이 값은 쓰이지 않는다.
# E2E_OTP_RELAY_REGEX=(\d{4,8})

# --- 텔레그램 봇 (폰에서 예약 실행, 선택) ---
# 설정하면 켜진다. 사용자별 연결은 웹 계정 화면에서 한다. 만드는 법: docs/telegram_bot.md
# E2E_TELEGRAM_BOT_TOKEN=

# --- Chrome 프로필 (선택) ---
# HOM·FP·HRP: 설치형 보안프로그램 호환을 위해 전용 프로필을 쓴다. 아래는 프로필들이
# 담기는 루트 경로이며(시스템별 이름이 하위에 붙는다), 미설정 시 ~/.e2etester 를 쓴다.
# E2E_USER_DATA_DIR=C:\Users\you\.e2etester
# MHM·HWTC·CHBOT: Playwright MCP 와 동일 프로필. 미설정 시
# %LOCALAPPDATA%/ms-playwright-mcp/mcp-chrome-{workspace_hash} 를 자동 사용한다.
# MCP 브라우저와 동시에 열면 프로필 잠금 오류가 난다.
# E2E_PLAYWRIGHT_MCP_PROFILE_DIR=C:\Users\you\AppData\Local\ms-playwright-mcp\mcp-chrome-34d9f53
# 위 workspace_hash 계산의 기준 경로. 미설정 시 저장소 루트.
# E2E_WORKSPACE_DIR=C:\Users\you\Desktop\e2eTester
